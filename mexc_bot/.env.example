# Nusxa oling: cp .env.example .env  — va .env ni hech qachon GitHub'ga yuklamang!

# mexc | binance
EXCHANGE=binance

# paper = virtual pul, kalit kerak emas
# demo  = Binance Demo Trading (demo.binance.com kalitlari), virtual pul
# live  = haqiqiy pul
MODE=demo

# Binance: demo uchun demo.binance.com -> API Management dan oling (asosiy hisob kalitlari ishlamaydi)
BINANCE_API_KEY=
BINANCE_SECRET=

# MEXC (faqat live uchun). Withdraw ruxsatini BERMANG!
MEXC_API_KEY=
MEXC_SECRET=

# Tahlil qilinadigan coinlar (vergul bilan). Bo'sh qolsa — standart 20 ta:
# BTC,ETH,SOL,BNB,XRP,DOGE,ADA,AVAX,LINK,DOT,LTC,TRX,NEAR,SUI,APT,ARB,OP,FIL,ATOM,AAVE
SYMBOLS=
TIMEFRAME=1m
LEVERAGE=20
MARGIN_SHARE=0.95
TP_PCT=1.0
SL_PCT=0.5
# FEE_PCT bo'sh qolsa: binance 0.05, mexc 0.02 (faqat paper hisob-kitobi uchun)
FEE_PCT=
TARGET_X=4
MAX_LOSSES_IN_ROW=3
MIN_BALANCE=5
PAPER_BALANCE=100
