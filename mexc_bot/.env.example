# Nusxa oling: cp .env.example .env  — va .env ni hech qachon GitHub'ga yuklamang!

# Birja: binance yoki mexc
EXCHANGE=binance

# paper = virtual pul (kalit kerak emas)
# demo  = Binance Demo Trading (demo.binance.com kalitlari), virtual pul
# live  = haqiqiy pul
MODE=demo

# Binance: demo uchun demo.binance.com -> API Management dan oling (asosiy hisob kalitlari ishlamaydi)
BINANCE_API_KEY=
BINANCE_SECRET=

# MEXC (faqat live uchun). Withdraw ruxsatini BERMANG!
MEXC_API_KEY=
MEXC_SECRET=

# ---------------------------------------------------------------------------
# Strategiya sozlamalari — ixtiyoriy. Yozilmasa, quyidagi standart qiymatlar ishlaydi.
# O'zgartirish uchun qator boshidagi # belgisini olib tashlang va qiymatni yozing.
# ---------------------------------------------------------------------------
# Har savdoga balansning necha foizi marja sifatida tikiladi (1 = 1%)
# MARGIN_PCT=1
# Leverage (plecho)
# LEVERAGE=10
# Narx foyda tomonga necha % yursa yopiladi (10x da 3% = Binance'da ROI +30%)
# TP_PCT=3
# Martingeyl o'chiq bo'lganda: narx qarshi tomonga necha % yursa yopiladi (10x da 1% = ROI -10%)
# SL_PCT=1
# Bir vaqtda nechta coinda savdo ochiq bo'lishi mumkin
# MAX_POSITIONS=20
# Barcha pozitsiyalar marjasi balansning necha foizidan oshmasin (martingeyl bilan birga)
# MAX_MARGIN_PCT=50
# Martingeyl qadamlari (0 = o'chiq). Narx kirishdan har MARTINGALE_STEP_PCT % qarshi yursa ×MARTINGALE_MULT qo'shiladi
# MARTINGALE_STEPS=2
# MARTINGALE_STEP_PCT=1
# MARTINGALE_MULT=2
# Martingeyl qilingan coin shu sof foydada (USDT) to'liq yopiladi
# MARTINGALE_PROFIT_USDT=1
# Martingeyldan keyingi oxirgi stop-loss (kirishdan narx %)
# MARTINGALE_SL_PCT=3
# Bugungi zarar balansning necha foiziga yetsa, ertagacha yangi savdo ochilmaydi
# DAILY_LOSS_PCT=3
# Shamlar: 1m, 5m, 15m, 1h
# TIMEFRAME=5m
# Necha daqiqada bir balans holati chiqarilsin
# STATUS_MINUTES=5
# Hajm bo'yicha nechta eng likvid coin ko'rib chiqiladi
# TOP_COINS=50
# Grafigi o'xshash deb hisoblash chegarasi (korrelyatsiya, 0..1). Ko'proq coin kerak bo'lsa 0.85, kamroq — 0.7
# CORR_MAX=0.8
# O'xshashlik qaysi shamlar va necha sham bo'yicha o'lchanadi (168 × 1h = 7 kun)
# CORR_TIMEFRAME=1h
# CORR_LOOKBACK=168
# Kamida nechta coin qolsin
# MIN_COINS=10
# Coinlar ro'yxati necha soatda bir yangilanadi
# REFRESH_HOURS=6
# O'z ro'yxatingiz (bo'sh = avtomatik tanlash). O'xshashlik filtri baribir qo'llanadi
# SYMBOLS=BTC,ETH,SOL
# paper rejimdagi virtual balans
# PAPER_BALANCE=5000

# ---------------------------------------------------------------------------
# Razgon bot (razgon_bot.py) — ixtiyoriy sozlamalar
# ---------------------------------------------------------------------------
# RAZGON_MARGIN_PCT=5
# RAZGON_LEVERAGE=20
# Sof foyda (pozitsiyadan %, komissiyadan keyin) — shunda yopiladi
# RAZGON_PROFIT_PCT=0.1
# RAZGON_SL_PCT=2
# RAZGON_MAX_OPEN=5
# RAZGON_DAILY_LOSS_PCT=20
# RAZGON_SCAN_COINS=15
# Haqiqiy pulda (MODE=live) ishlatish uchun ataylab yoqish kerak:
# RAZGON_LIVE_OK=1

# ---------------------------------------------------------------------------
# Trend bot (trend_bot.py) va backtest.py — ixtiyoriy sozlamalar
# ---------------------------------------------------------------------------
# Necha daqiqada bir yangi savdo (10-15)
# TREND_INTERVAL_MIN=15
# TREND_MARGIN_PCT=10
# TREND_LEVERAGE=20
# Boshlang'ich SL va SL siljish qadami (narx %)
# TREND_SL_PCT=1
# TREND_STEP_PCT=1
# TP (0 = yo'q, foyda trend davom etguncha o'sadi)
# TREND_TP_PCT=0
# TREND_MAX_OPEN=3
# TREND_DAILY_LOSS_PCT=15
# TREND_SCAN_COINS=20
# Haqiqiy pulda (MODE=live) ishlatish uchun ataylab yoqish kerak:
# TREND_LIVE_OK=1

# ---------------------------------------------------------------------------
# Swing bot (swing_bot.py) va backtest.py --swing — ixtiyoriy sozlamalar
# ---------------------------------------------------------------------------
# Har qism SL urilsa balansning necha foizi yo'qotiladi
# SWING_RISK_PCT=2
# Boshlang'ich SL = shuncha × ATR(1h); chandelier SL = eng yaxshi narx − shuncha × ATR
# SWING_STOP_ATR=2.5
# SWING_TRAIL_ATR=3
# Piramida: har necha ATR da yangi qism, jami nechta qism (1 = piramidasiz)
# SWING_ADD_ATR=1
# SWING_MAX_UNITS=3
# Yorish uchun necha soatlik eng yuqori/past nuqta
# SWING_BREAKOUT_BARS=48
# SWING_LEVERAGE=10
# SWING_MAX_OPEN=3
# SWING_MAX_MARGIN_PCT=80
# Balans shuncha % oshsa hamma pozitsiya yopiladi (0 = o'chiq)
# SWING_TARGET_PCT=10
# SWING_DAILY_LOSS_PCT=15
# SWING_SCAN_COINS=20
# Haqiqiy pulda (MODE=live) ishlatish uchun ataylab yoqish kerak:
# SWING_LIVE_OK=1
