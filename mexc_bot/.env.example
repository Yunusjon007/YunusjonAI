# Nusxa oling: cp .env.example .env  — va .env ni hech qachon GitHub'ga yuklamang!

# Birja: binance yoki mexc
EXCHANGE=binance

# paper = virtual pul (kalit kerak emas)
# demo  = Binance Demo Trading (demo.binance.com kalitlari), virtual pul
# live  = haqiqiy pul
MODE=demo

# Binance: demo uchun demo.binance.com -> API Management dan oling (asosiy hisob kalitlari ishlamaydi)
BINANCE_API_KEY=
BINANCE_SECRET=

# MEXC (faqat live uchun). Withdraw ruxsatini BERMANG!
MEXC_API_KEY=
MEXC_SECRET=

# ---------------------------------------------------------------------------
# Strategiya sozlamalari — ixtiyoriy. Yozilmasa, quyidagi standart qiymatlar ishlaydi.
# O'zgartirish uchun qator boshidagi # belgisini olib tashlang va qiymatni yozing.
# ---------------------------------------------------------------------------
# Har savdoga balansning necha foizi marja sifatida tikiladi (1 = 1%)
# MARGIN_PCT=1
# Leverage (plecho)
# LEVERAGE=10
# Narx foyda tomonga necha % yursa yopiladi (10x da 3% = Binance'da ROI +30%)
# TP_PCT=3
# Narx qarshi tomonga necha % yursa yopiladi (10x da 1% = ROI -10%)
# SL_PCT=1
# Bir vaqtda nechta savdo ochiq bo'lishi mumkin
# MAX_POSITIONS=5
# Bugungi zarar balansning necha foiziga yetsa, ertagacha yangi savdo ochilmaydi
# DAILY_LOSS_PCT=3
# Shamlar: 1m, 5m, 15m, 1h
# TIMEFRAME=5m
# Necha daqiqada bir balans holati chiqarilsin
# STATUS_MINUTES=5
# Coinlar (bo'sh = standart 20 ta)
# SYMBOLS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA,AVAX,LINK,DOT,LTC,TRX,NEAR,SUI,APT,ARB,OP,FIL,ATOM,AAVE
# paper rejimdagi virtual balans
# PAPER_BALANCE=5000
