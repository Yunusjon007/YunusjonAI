# Nusxa oling: cp .env.example .env  — va .env ni hech qachon GitHub'ga yuklamang!

# paper = virtual pul (standart), live = haqiqiy pul
MODE=paper

# Faqat live uchun. MEXC -> API Management. Faqat "Futures trading" ruxsati, Withdraw YO'Q!
MEXC_API_KEY=
MEXC_SECRET=

SYMBOL=BTC/USDT:USDT
TIMEFRAME=1m
LEVERAGE=20
MARGIN_SHARE=0.95
TP_PCT=1.0
SL_PCT=0.5
FEE_PCT=0.02
TARGET_X=4
MAX_LOSSES_IN_ROW=3
MIN_BALANCE=5
PAPER_BALANCE=100
