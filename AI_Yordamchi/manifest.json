{
  "manifest_version": 3,
  "name": "AI Yordamchi — Direct va Chat",
  "version": "1.0.3",
  "minimum_chrome_version": "120",
  "description": "O‘zbekcha boshqaruv: ijtimoiy chatlar va mavjud AI veb-akkauntlari. API kalitisiz.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.instagram.com/*", "https://www.facebook.com/*",
    "https://www.messenger.com/*", "https://web.telegram.org/*",
    "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "AI Yordamchini ochish"},
  "content_scripts": [{
    "matches": [
      "https://www.instagram.com/*", "https://www.facebook.com/*",
      "https://www.messenger.com/*", "https://web.telegram.org/*",
      "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"
    ],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  }]
}
